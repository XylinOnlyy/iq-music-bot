# Required: your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: register commands instantly in one server while testing (leave empty for global commands)
GUILD_ID=

# Optional: Spotify API credentials (https://developer.spotify.com/dashboard).
# Without them the bot still works, but Spotify playlists are limited to their first 100 tracks.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: path to a Netscape-format cookies.txt. Helps when YouTube asks to "confirm you're not a bot"
# or when Instagram requires a login.
YTDLP_COOKIES=

# Optional: use your own yt-dlp / ffmpeg binaries instead of the bundled ones
YTDLP_PATH=
FFMPEG_PATH=

# Optional tuning
IDLE_TIMEOUT_MINUTES=10
ALONE_TIMEOUT_MINUTES=2
MAX_QUEUE_SIZE=1000
MAX_PLAYLIST_SIZE=300
MAX_CONCURRENT_DOWNLOADS=2
